{
  "name": "the-dungeon-masters-table",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "A one-stop shop for D&D Dungeon Masters — live session recording, AI session notes, character sheets, improv generators, and a synthesized soundboard.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c magenta,yellow \"vite\" \"node server/index.js\"",
    "dev:web": "vite",
    "dev:api": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "npm run build && npm start",
    "verify": "node verify.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "openai": "^6.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
